    "build": "tsc && vite build",
    "preview": "vite preview",
    "demo": "node demo/server.mjs"
  },
  "devDependencies": {
    "@tanstack/ai": "^0.21.3",
    "@tanstack/ai-code-mode": "^0.1.20",
