    "@tanstack/ai-gemini": "^0.10.10",
    "@tanstack/ai-isolate-quickjs": "^0.1.20",
    "@tanstack/ai-openai": "^0.10.0",
    "lit": "^3.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "zod": "^4.4.3"
  },
