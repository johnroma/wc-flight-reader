{
  "name": "wc-flight-reader",
  "private": false,
  "version": "0.2.1",
  "description": "Drop a flight screenshot — get structured itinerary data back.",
  "author": {
    "name": "John Romani",
    "email": "john@anthood.com"
  },
  "keywords": [
    "web components",
    "ai",
    "flight",
    "itinerary",
    "gemini",
    "openai"
  ],
  "homepage": "https://github.com/johnroma/wc-flight-reader",
  "type": "module",
  "repository": "https://github.com/johnroma/wc-flight-reader",
  "license": "MIT",
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/wc-flight-reader.js",
  "types": "./types/index.d.ts",
  "exports": {
